# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a Git.

# Entorno: development | production
NODE_ENV=development

# Puerto del servidor
PORT=3001

# URL pública (la que ve el cliente). En dev: http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3001

# Origen permitido para CORS en producción (separa con comas si son varios)
# CORS_ORIGIN=https://milocosmetics.com

# Secreto para firmar JWTs — genera uno largo y aleatorio
# Ejemplo (Mac/Linux): openssl rand -base64 48
JWT_SECRET=cambia-esto-por-uno-largo-y-aleatorio

# Correo del admin (único que puede modificar productos)
ADMIN_EMAIL=jaugustojc07@gmail.com

# Mercado Pago — token de tu app
# Para el webhook, configura en tu panel de MP:
#   https://www.mercadopago.com.mx/developers/panel/app/webhooks
# URL: {PUBLIC_BASE_URL}/webhooks/mercadopago    Evento: payment
MP_ACCESS_TOKEN=

# Skydropx (envíos) — opcional, sin esto se usan tarifas mock
SKYDROPX_API_KEY=
SKYDROPX_API_URL=https://api.skydropx.com/v1

# Correo para mandar recibos (Gmail u otro SMTP)
EMAIL_USER=
EMAIL_PASS=
